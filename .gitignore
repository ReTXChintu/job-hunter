# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
target/
apps/desktop/src-tauri/gen/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Generated user data (never commit personal documents)
storage/resumes/*
storage/cover-letters/*
storage/generated/*
storage/exports/*
!storage/**/.gitkeep

# Logs
*.log
logs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Uploaded app builds served by the backend
apps/backend/downloads/

# PM2 runtime files
.pm2/

# Firebase credentials and their encodings: secrets, never committed.
# (The server reads the service account from JOB_HUNTER_BACKEND_FCM_SERVICE_ACCOUNT,
# CI gets google-services.json from the GOOGLE_SERVICES_JSON secret.)
*firebase-adminsdk*.json
/google-services.json
*.b64
