# Job Hunter backend configuration. Copy to .env for local development, or
# set these as real environment variables when deploying. Never commit a
# real .env.

# Port the HTTP/WebSocket server listens on.
JOB_HUNTER_BACKEND_PORT=8788

# REQUIRED: the same MongoDB Atlas connection string the desktop app
# already uses to sync. This backend becomes the one thing that talks to
# it directly.
JOB_HUNTER_BACKEND_MONGODB_URI=

# Database name within that cluster.
JOB_HUNTER_BACKEND_MONGODB_DATABASE=job_hunter

# REQUIRED in production: a long, random secret used to sign access
# tokens. Generate one with, e.g.: openssl rand -hex 32
# If unset, a non-production run falls back to an insecure development
# value and logs a warning; a production run (NODE_ENV=production) refuses
# to start.
JOB_HUNTER_BACKEND_JWT_SECRET=

# Token lifetimes.
JOB_HUNTER_BACKEND_ACCESS_TTL_SECS=900
JOB_HUNTER_BACKEND_REFRESH_TTL_DAYS=30
JOB_HUNTER_BACKEND_PAIRING_TTL_SECS=300

# Comma-separated list of allowed CORS origins. Leave empty to allow any
# origin (fine for a personal backend reached only by the desktop app and
# the mobile app, neither of which is a browser page).
JOB_HUNTER_BACKEND_CORS_ORIGINS=
