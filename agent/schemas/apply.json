{
  "type": "object",
  "properties": {
    "outcome": { "type": "string", "enum": ["SUBMITTED", "HUMAN_INPUT_REQUIRED", "MANUAL_ACTION_REQUIRED", "FAILED"] },
    "reason": { "type": "string" },
    "evidence": { "type": "string" },
    "applicationUrl": { "type": "string" },
    "answersUsed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "source": { "type": "string", "enum": ["KNOWN", "USER", "PROFILE", "SKIPPED"] }
        },
        "required": ["question", "answer", "source"]
      }
    },
    "unknownQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "fieldType": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "context": { "type": "string" }
        },
        "required": ["question"]
      }
    },
    "stepsCompleted": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["outcome", "reason"]
}
