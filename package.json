{
  "name": "job-hunter",
  "private": true,
  "version": "0.1.3",
  "description": "Job Hunter - a local-first, Claude Code powered personal job hunting assistant",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @job-hunter/desktop dev",
    "tauri": "pnpm --filter @job-hunter/desktop tauri",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:rust": "cargo test --workspace",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "server:build": "pnpm --filter @job-hunter/web build && pnpm --filter @job-hunter/backend build",
    "server:start": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "server:stop": "pm2 stop ecosystem.config.cjs",
    "server:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "server:logs": "pm2 logs job-hunter-backend --lines 200",
    "server:status": "pm2 status",
    "server:delete": "pm2 delete ecosystem.config.cjs",
    "server:update": "git pull --ff-only && pnpm install --frozen-lockfile && pnpm server:build && pnpm server:start",
    "release": "release-it",
    "release:patch": "release-it patch --ci",
    "release:minor": "release-it minor --ci",
    "release:major": "release-it major --ci",
    "release:dry": "release-it --dry-run --ci",
    "versions:check": "node scripts/sync-versions.mjs --check"
  },
  "devDependencies": {
    "pm2": "^7.0.4",
    "release-it": "^21.1.0"
  }
}
