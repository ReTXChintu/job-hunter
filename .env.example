# Job Hunter - non-secret configuration examples.
# Copy to .env for local development. Never commit a real .env.
#
# NOTE: There is intentionally NO ANTHROPIC_API_KEY here. Job Hunter uses your
# already-authenticated Claude Code / Claude CLI installation for all AI work.

APP_ENV=development

# MongoDB Atlas. Leave empty here and configure it from Settings inside the app,
# where the URI is stored in the operating system credential store (Windows
# Credential Manager / macOS Keychain / Linux Secret Service), never in plain text.
MONGODB_URI=
MONGODB_DATABASE=job_hunter

# Optional overrides. Leave empty to auto-detect.
CLAUDE_CLI_PATH=
CHROME_PATH=

# When true the agent runs against deterministic fixtures instead of Claude
# Code and Chrome. For development and automated tests only.
MOCK_MODE=false
