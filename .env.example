# Job Hunter - non-secret configuration examples.
# Copy to .env for local development. Never commit a real .env.
#
# NOTE: There is intentionally NO ANTHROPIC_API_KEY here. Job Hunter uses your
# already-authenticated Claude Code / Claude CLI installation for all AI work.

APP_ENV=development

# The Job Hunter server the desktop app talks to during development
# (`pnpm tauri dev`). Release builds have it baked in at build time from the
# BACKEND_URL GitHub secret instead, and there is no URL field in the app.
# Defaults to http://127.0.0.1:8788, i.e. `pnpm --filter @job-hunter/backend dev`.
JOB_HUNTER_BACKEND_URL=

# Optional overrides. Leave empty to auto-detect.
CLAUDE_CLI_PATH=
CHROME_PATH=

# When true the agent runs against deterministic fixtures instead of Claude
# Code and Chrome. For development and automated tests only.
MOCK_MODE=false

# Optional: use a different data directory (useful for demos and testing).
JOB_HUNTER_DATA_DIR=
