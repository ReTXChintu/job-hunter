# Job Hunter configuration: the ONE .env for the whole repository.
#
# Copy this to `.env` in the repository root. Every part of the repo reads
# that single file: the desktop app in development, the backend server
# (locally and under PM2), the web app's dev server, and the legacy relay.
# Real environment variables always take precedence over it.
# Never commit a real .env.
#
# NOTE: There is intentionally NO ANTHROPIC_API_KEY here. Job Hunter uses your
# already-authenticated Claude Code / Claude CLI installation for all AI work.

# =============================================================================
# Desktop app (development only)
# =============================================================================

# The Job Hunter server the desktop app talks to during `pnpm tauri dev`.
# Release builds have it baked in at build time from the BACKEND_URL GitHub
# secret instead, and there is no URL field in the app. The web app's dev
# server also proxies API calls here.
# Defaults to http://127.0.0.1:<JOB_HUNTER_BACKEND_PORT>, i.e. the backend
# started with `pnpm --filter @job-hunter/backend dev`.
JOB_HUNTER_BACKEND_URL=

# Optional overrides. Leave empty to auto-detect.
CLAUDE_CLI_PATH=
CHROME_PATH=

# When true the agent runs against deterministic fixtures instead of Claude
# Code and Chrome. For development and automated tests only.
MOCK_MODE=false

# Optional: use a different data directory (useful for demos and testing).
JOB_HUNTER_DATA_DIR=

# =============================================================================
# Server (apps/backend): API, web app, app downloads. See docs/deploy.md.
# =============================================================================

# Port the server listens on. It binds 0.0.0.0, so this is the port clients
# use in http://<server-ip>:<port>.
JOB_HUNTER_BACKEND_PORT=8788

# Optional: serve the web app on its own port instead of the API port. The
# API port then serves only the API (what the desktop and mobile apps use);
# this port serves the web app plus the API calls the page makes, so the page
# needs no CORS setup. Leave empty to serve everything on one port.
JOB_HUNTER_BACKEND_WEB_PORT=

# REQUIRED: your MongoDB Atlas connection string. If `mongodb+srv://` fails
# with "querySrv ETIMEOUT", use Atlas's non-SRV mongodb://host1,host2,... form.
JOB_HUNTER_BACKEND_MONGODB_URI=

# Database name within that cluster.
JOB_HUNTER_BACKEND_MONGODB_DATABASE=job_hunter

# REQUIRED in production: a long, random secret used to sign access tokens.
# Generate one with, e.g.: openssl rand -hex 32
# If unset, a non-production run falls back to an insecure development value
# and logs a warning; a production run (NODE_ENV=production, as under PM2)
# refuses to start.
JOB_HUNTER_BACKEND_JWT_SECRET=

# Token lifetimes.
JOB_HUNTER_BACKEND_ACCESS_TTL_SECS=900
JOB_HUNTER_BACKEND_REFRESH_TTL_DAYS=30
JOB_HUNTER_BACKEND_PAIRING_TTL_SECS=300

# Comma-separated list of allowed CORS origins. Leave empty to allow any
# origin. The web app is served from the server itself, so it needs none.
JOB_HUNTER_BACKEND_CORS_ORIGINS=

# Where the built web app lives (served at http://<ip>:<port>/).
# Relative paths are relative to the repository root. Default: apps/web/dist
JOB_HUNTER_BACKEND_WEB_DIR=

# Where downloadable app builds live: the newest .apk and Windows installer
# here are served at /downloads/android and /downloads/windows.
# Relative paths are relative to the repository root. Default: apps/backend/downloads
JOB_HUNTER_BACKEND_DOWNLOADS_DIR=

# =============================================================================
# Legacy relay (crates/job-hunter-relay). Superseded by the server above and
# not part of a normal deployment; only needed if you still run it.
# See docs/relay.md.
# =============================================================================

# Bind address for the HTTP/WebSocket server.
JOB_HUNTER_RELAY_BIND=0.0.0.0:8787

# Path to the SQLite database file (accounts, devices, refresh tokens,
# pairing codes only -- never job or resume content).
JOB_HUNTER_RELAY_DB=relay.sqlite3

# REQUIRED in production: a long, random secret used to sign access tokens.
# If unset, a debug build falls back to an insecure development-only value
# and a release build refuses to start.
JOB_HUNTER_RELAY_JWT_SECRET=

# Token lifetimes.
JOB_HUNTER_RELAY_ACCESS_TTL_SECS=900
JOB_HUNTER_RELAY_REFRESH_TTL_DAYS=30
JOB_HUNTER_RELAY_PAIRING_TTL_SECS=300

# Comma-separated list of allowed CORS origins. Leave empty to allow any.
JOB_HUNTER_RELAY_CORS_ORIGINS=

# Tracing filter, e.g. "info,job_hunter_relay=debug".
JOB_HUNTER_RELAY_LOG=info
